{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "includes": [
      "**",
      "!!.tanstack",
      "!!.wrangler",
      "!!dist",
      "!!node_modules",
      "!!playwright-report",
      "!!pnpm-lock.yaml",
      "!!src/routeTree.gen.ts",
      "!!test-results"
    ]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2 },
  "css": {
    "parser": { "tailwindDirectives": true }
  },
  "javascript": {
    "formatter": { "quoteStyle": "single", "semicolons": "asNeeded" }
  }
}
