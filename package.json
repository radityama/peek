{
  "name": "@radityprtama/peek",
  "version": "0.2.1",
  "description": "Run your dev server. Share it instantly.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/radityprtama/peek.git"
  },
  "homepage": "https://github.com/radityprtama/peek#readme",
  "bugs": {
    "url": "https://github.com/radityprtama/peek/issues"
  },
  "type": "module",
  "bin": {
    "peek": "dist/cli.js"
  },
  "exports": {
    "./package.json": "./package.json",
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js",
      "default": "./dist/config.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.20.0",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsdown --watch",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "build": "tsdown",
    "pack:check": "npm pack --dry-run",
    "smoke:pack": "node scripts/smoke-pack.mjs",
    "prepack": "pnpm build"
  },
  "license": "MIT",
  "dependencies": {
    "citty": "^0.2.2",
    "consola": "^3.4.2",
    "execa": "^10.0.1",
    "jiti": "^2.7.0",
    "package-manager-detector": "^1.8.0",
    "picocolors": "^1.1.1",
    "qrcode-terminal": "^0.12.0",
    "semver": "^7.8.5",
    "which-command": "^0.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^26.6.2",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/semver": "^7.8.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
